// Local development only. Deployed hosting uses deploy.manifest.json.
// Secrets (AITQR_ADMIN_KEY, AITQR_SESSION_KEY, AITQR_SETUP_CODE) are set with
// `npx wrangler secret put NAME` or through the hosting dashboard — never in this file.
{
  "name": "aitqr",
  "main": "server/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "aitqr-local",
      "database_id": "00000000-0000-0000-0000-000000000000"
    }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:8787"
  }
}
