{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "outDir": ".backend-build",
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  "include": ["backend/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "tools", "scripts", "server"]
}
