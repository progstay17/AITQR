{
  "name": "aitqr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "AITQR — profile-driven encrypted MQ1 QR issuer for field staff with a self-hosted Node.js API and SQLite database.",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.backend.json",
    "pretest": "npm run build",
    "test": "node --test test/*.test.ts",
    "build": "node scripts/build.mjs",
    "start": "node scripts/serve.mjs",
    "dev": "npm run build && node scripts/serve.mjs",
    "bundle:sign": "node tools/sign-bundle.ts",
    "bundle:lint": "node tools/lint-profile.ts",
    "bundle:budget": "node tools/budget.ts",
    "bundle:vectors": "node tools/make-vectors.ts",
    "keys:init": "node tools/gen-keys.ts"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
